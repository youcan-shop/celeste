{
  "name": "@youcan/celeste",
  "type": "module",
  "version": "0.24.1",
  "author": "YouCan <tech@youcan.shop>",
  "repository": {
    "type": "git",
    "url": "https://github.com/youcan-shop/celeste"
  },
  "keywords": [
    "youcan",
    "celeste"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/es/index.js",
      "require": "./dist/cjs/index.cjs"
    },
    "./assets/celeste.css": "./dist/celeste.css"
  },
  "main": "./dist/cjs/index.cjs",
  "module": "./dist/es/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "ai",
    "dist",
    "src"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "codegen:registry": "tsx scripts/component-registry/index.ts",
    "build": "rimraf dist && pnpm run codegen:registry && vue-tsc --declaration --emitDeclarationOnly -p tsconfig.build.json && vite build",
    "build-only": "vite build",
    "watch": "vite build --watch",
    "type-check": "vue-tsc -p tsconfig.check.json --noEmit",
    "type-gen": "vue-tsc --declaration  --emitDeclarationOnly",
    "storybook": "NODE_ENV=dev storybook dev -p 6006",
    "build-storybook": "NODE_ENV=dev storybook build"
  },
  "peerDependencies": {
    "vue": "^3.5.13"
  },
  "dependencies": {
    "@internationalized/date": "^3.12.4",
    "@tiptap/core": "^3.33.0",
    "@tiptap/extension-bubble-menu": "^3.33.0",
    "@tiptap/extension-color": "^3.33.0",
    "@tiptap/extension-link": "^3.33.0",
    "@tiptap/extension-text-align": "^3.33.0",
    "@tiptap/extension-text-style": "^3.33.0",
    "@tiptap/extensions": "^3.33.0",
    "@tiptap/pm": "^3.33.0",
    "@tiptap/starter-kit": "^3.33.0",
    "@tiptap/vue-3": "^3.33.0",
    "@unovis/ts": "1.8.0",
    "@unovis/vue": "1.8.0",
    "@vueuse/core": "^15.0.0",
    "@youcan/celeste-icons": "workspace:*",
    "@youcan/celeste-tokens": "workspace:*",
    "clsx": "^2.1.1",
    "reka-ui": "~2.11.0",
    "tinycolor2": "^1.6.0",
    "vue-sonner": "^2.0.9"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.6.0",
    "@storybook/addon-docs": "^10.6.6",
    "@storybook/addon-themes": "10.6.6",
    "@storybook/vue3-vite": "^10.6.6",
    "@tsconfig/node20": "^20.1.10",
    "@types/tinycolor2": "^1.4.6",
    "@unocss/reset": "^66.12.0",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/compiler-core": "^3.5.45",
    "@vue/tsconfig": "^0.9.1",
    "autoprefixer": "^10.6.2",
    "chromatic": "^18.14.2",
    "eslint-plugin-storybook": "^10.6.6",
    "glob": "^14.0.4",
    "postcss": "^8.5.32",
    "postcss-nesting": "^14.0.3",
    "rimraf": "^6.1.4",
    "sass": "^1.108.1",
    "storybook": "^10.6.6",
    "tsx": "^4.23.15",
    "unocss": "^66.12.0",
    "vite": "^8.3.6",
    "vite-plugin-dts": "^5.1.2",
    "vue-component-meta": "^3.3.14",
    "vue-tsc": "^3.3.14"
  }
}
