{
  "name": "@youcan/celeste-icons",
  "type": "module",
  "version": "0.25.0",
  "author": "YouCan <tech@youcan.shop>",
  "repository": {
    "type": "git",
    "url": "https://github.com/youcan-shop/celeste"
  },
  "keywords": [
    "youcan",
    "celeste"
  ],
  "exports": {
    "./icons.json": "./dist/icons.json",
    "./info.json": "./dist/info.json",
    "./*": "./dist/*",
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      }
    }
  },
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "iconSet": {
    "icons": "./dist/icons.json",
    "info": "./dist/info.json"
  },
  "scripts": {
    "generate-iconify": "tsx scripts/generate-iconify",
    "build": "rimraf dist && pnpm generate-iconify && obuild"
  },
  "dependencies": {
    "@iconify/types": "^2.0.0"
  },
  "devDependencies": {
    "@iconify/tools": "^5.0.14",
    "obuild": "^0.4.45",
    "rimraf": "^6.1.4",
    "tsx": "^4.23.15"
  }
}
