{
  "name": "celeste",
  "type": "module",
  "version": "0.24.1",
  "private": true,
  "packageManager": "pnpm@12.18.0+sha512.9d7882d5dc82147ecfc4e062aa34834e0ad0296710a1837a1115ae012127d36b7109e321ac1598a1dd0a65597681b1e99917e12ed0d749eae91187943363beb3",
  "description": "YouCan's design system.",
  "author": "YouCan <tech@youcan.shop>",
  "repository": {
    "type": "git",
    "url": "https://github.com/youcan-shop/celeste"
  },
  "keywords": [
    "youcan",
    "celeste"
  ],
  "scripts": {
    "eslint": "eslint . --cache",
    "eslint:fix": "eslint . --cache --fix",
    "stylelint": "stylelint ./**/*.vue --cache",
    "stylelint:fix": "stylelint ./**/*.vue --cache --fix",
    "lint": "pnpm run eslint && pnpm run stylelint",
    "lint:fix": "pnpm run eslint:fix && pnpm run stylelint:fix",
    "prepare": "pnpm simple-git-hooks",
    "build": "pnpm -r build",
    "bump": "bumpp package.json packages/*/package.json --commit \"chore: release v\" --push --tag",
    "release": "pnpm bump",
    "storybook": "pnpm --filter @youcan/celeste run storybook"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@types/node": "^26.1.2",
    "@unocss/eslint-plugin": "^66.7.5",
    "@youcan/lint": "^4.0.0",
    "bumpp": "^12.2.0",
    "eslint": "^10.8.0",
    "eslint-plugin-format": "^2.0.1",
    "lint-staged": "^17.3.0",
    "postcss-html": "^2.0.0",
    "rimraf": "^6.1.3",
    "simple-git-hooks": "^2.13.1",
    "stylelint": "^17.14.1",
    "stylelint-config-property-sort-order-smacss": "^11.2.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "stylelint-config-standard-vue": "^2.0.0",
    "typescript": "^6.0.3"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged",
    "commit-msg": "pnpm commitlint --edit ${1}"
  },
  "lint-staged": {
    "*": "eslint --fix"
  }
}
